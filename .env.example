# Public site URL (used for OGP/Twitter metadataBase, e.g. https://goi-shokan.pages.dev)
NEXT_PUBLIC_SITE_URL=

# X creator handle (without or with @, e.g. my_x_id) & promo post URL for quote-repost shares
NEXT_PUBLIC_X_CREATOR_HANDLE=
NEXT_PUBLIC_X_PROMO_POST_URL=

# Dictionary base URL:
# - Leave unset for local /dict assets
# - Set to your Cloudflare Pages dictionary URL (e.g. https://goi-shokan-dict.pages.dev) in production
NEXT_PUBLIC_DICT_BASE_URL=

# Supabase (for leaderboard / ranking integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
